def _find_icon():
    for path in ICON_CANDIDATES:
        if os.path.isfile(path):
            return path
    return None


def _rom_display_name(path):
    if not path:
        return ''
    return os.path.splitext(os.path.basename(path))[0]


def _first_joystick():
    devs = sorted(glob.glob('/dev/input/js*'))
    return devs[0] if devs else None


def _joystick_name(path):
    dev = os.path.basename(path)
    try:
        with open(f'/sys/class/input/{dev}/device/name') as f:
            return f.read().strip()
    except OSError:
        return None


def _joystick_index(path):
    digits = ''.join(c for c in os.path.basename(path) if c.isdigit())
    return int(digits) if digits else 0


def _load_bindings():
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    if os.path.exists(MUPEN64_CFG):
        try:
            cfg.read(MUPEN64_CFG)
        except configparser.Error:
            return {}
    if not cfg.has_section(CONTROL_SECTION):
        return {}
    return {k: v.strip('"') for k, v in cfg[CONTROL_SECTION].items()}


def _open_cfg():
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    if os.path.exists(MUPEN64_CFG):
        try:
            cfg.read(MUPEN64_CFG)
        except configparser.Error:
            pass
    if not cfg.has_section(CONTROL_SECTION):
        cfg.add_section(CONTROL_SECTION)
        cfg[CONTROL_SECTION]['plugged'] = 'True'
        cfg[CONTROL_SECTION]['plugin'] = '2'
        cfg[CONTROL_SECTION]['device'] = '0'
    return cfg


def _write_cfg(cfg):
    os.makedirs(os.path.dirname(MUPEN64_CFG), exist_ok=True)
    with open(MUPEN64_CFG, 'w') as f:
        cfg.write(f)


def _save_binding(button_key, value):
    cfg = _open_cfg()
    cfg[CONTROL_SECTION][button_key] = f'"{value}"'
    _write_cfg(cfg)


def _apply_auto_config(js_path):
    """Point mupen64plus at the detected joystick and apply generic gamepad
    bindings. Returns (name, applied_count) or (None, 0) if no joystick."""
    if not js_path:
        return None, 0
    cfg = _open_cfg()
    cfg[CONTROL_SECTION]['plugged'] = 'True'
    cfg[CONTROL_SECTION]['plugin'] = '2'
    cfg[CONTROL_SECTION]['mode'] = '0'  # 0 = fully manual, apply our bindings
    cfg[CONTROL_SECTION]['device'] = str(_joystick_index(js_path))
    name = _joystick_name(js_path)
    if name:
        cfg[CONTROL_SECTION]['name'] = f'"{name}"'
    for key, value in GENERIC_GAMEPAD_BINDINGS.items():
        cfg[CONTROL_SECTION][key] = f'"{value}"'
    _write_cfg(cfg)
    return name, len(GENERIC_GAMEPAD_BINDINGS)


# ---------- persisted preferences (library.ini) ----------
def _prefs_read():
    cfg = configparser.ConfigParser(interpolation=None)
    if os.path.exists(LIBRARY_CFG_PATH):
        try:
            cfg.read(LIBRARY_CFG_PATH)
        except configparser.Error:
            pass
    if not cfg.has_section('Library'):
        cfg.add_section('Library')
    return cfg


def _prefs_write(cfg):
    os.makedirs(os.path.dirname(LIBRARY_CFG_PATH), exist_ok=True)
    with open(LIBRARY_CFG_PATH, 'w') as f:
        cfg.write(f)


def _pref_get(key, default=None):
    return _prefs_read()['Library'].get(key, default)


def _pref_set(key, value):
    cfg = _prefs_read()
    cfg['Library'][key] = value
    _prefs_write(cfg)


def _pref_get_bool(key, default):
    v = _pref_get(key)
    if v is None:
        return default
    return v.lower() in ('1', 'true', 'yes', 'on')


def _get_library_folder():
    folder = _pref_get('folder') or None
    return folder or None


def _set_library_folder(path):
    _pref_set('folder', path)


def _list_roms(folder):
    if not folder or not os.path.isdir(folder):
        return []
    try:
        entries = sorted(os.listdir(folder))
    except OSError:
        return []
    exts = tuple(p.lstrip('*') for p in ROM_PATTERNS)  # .n64 .z64 .v64
    return [
        os.path.join(folder, name)
        for name in entries
        if name.lower().endswith(exts)
        and os.path.isfile(os.path.join(folder, name))
    ]


# ---------- box art ----------
def _load_boxart_index():
    if not os.path.exists(BOXART_INDEX_PATH):
        return []
    try:
        with open(BOXART_INDEX_PATH) as f:
            return [line.strip() for line in f if line.strip()]
    except OSError:
        return []


def _save_boxart_index(slugs):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(BOXART_INDEX_PATH, 'w') as f:
            f.write('\n'.join(slugs))
    except OSError:
        pass


_SLUG_RE = re.compile(r'galleries/N64-box/([^"\']+?)-th\.jpg')


def _fetch_boxart_index():
    """Scrape arcadeartwork.org N64 category to build a slug list."""
    slugs = []
    seen = set()
    for i in range(BOXART_MAX_PAGES):
        start = i * BOXART_PAGE_SIZE
        url = BOXART_CATEGORY_URL if start == 0 else BOXART_PAGE_URL.format(start=start)
        try:
            req = urllib.request.Request(url, headers={'User-Agent': BOXART_UA})
            with urllib.request.urlopen(req, timeout=BOXART_TIMEOUT) as r:
                html = r.read().decode('utf-8', errors='replace')
        except (urllib.error.URLError, TimeoutError, OSError):
            break
        new = 0
        for slug in _SLUG_RE.findall(html):
            if slug not in seen:
                seen.add(slug)
                slugs.append(slug)
                new += 1
        if new == 0:
            break
    return slugs


def _normalize(s):
    if not s:
        return ''
    s = re.sub(r'[\(\[][^)\]]*[)\]]', ' ', s)  # drop (USA)/[!]/etc.
    s = re.sub(r'[^A-Za-z0-9]+', ' ', s).lower()
    return ' '.join(s.split())


def _match_slug(rom_name, slugs):
    """Pick the best-matching slug for a ROM display name."""
    target = _normalize(rom_name)
    if not target or not slugs:
        return None
    t_tokens = target.split()
    t_set = set(t_tokens)
    best = None
    best_score = 0.0
    best_len = 0
    for slug in slugs:
        norm = _normalize(slug)
        if not norm:
            continue
        if norm == target:
            return slug
        s_tokens = norm.split()
        s_set = set(s_tokens)
        common = t_set & s_set
        if not common:
            continue
        score = 2 * len(common) / (len(t_set) + len(s_set))
        # Prefer matches that cover more of the ROM name tokens.
        if score > best_score or (score == best_score and len(norm) > best_len):
            best = slug
            best_score = score
            best_len = len(norm)
    return best if best_score >= 0.55 else None


def _boxart_local_path(slug):
    return os.path.join(BOXART_DIR, slug + '.jpg')


def _download_boxart(slug):
    """Download to cache. Return local path on success, None on failure."""
    if not slug:
        return None
    dest = _boxart_local_path(slug)
    if os.path.exists(dest) and os.path.getsize(dest) > 0:
        return dest
    url = BOXART_IMAGE_URL.format(slug=urllib.parse.quote(slug, safe=''))
    try:
        req = urllib.request.Request(url, headers={'User-Agent': BOXART_UA})
        with urllib.request.urlopen(req, timeout=BOXART_TIMEOUT) as r:
            data = r.read()
    except (urllib.error.URLError, TimeoutError, OSError):
        return None
    if not data:
        return None
    try:
        os.makedirs(BOXART_DIR, exist_ok=True)
        tmp = dest + '.part'
        with open(tmp, 'wb') as f:
            f.write(data)
        os.replace(tmp, dest)
    except OSError:
        return None
    return dest


def _load_pixbuf(path, max_w, max_h):
    if not path or not os.path.isfile(path):
        return None
    try:
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(
            path, max_w, max_h, True,
        )
    except GLib.Error:
        return None


class JoystickReader:
    """Read raw events from /dev/input/jsX (Linux joystick API)."""

    STRUCT = struct.Struct('IhBB')

    def __init__(self, path):
        self.path = path
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        flags = fcntl.fcntl(self.fd, fcntl.F_GETFL)
        fcntl.fcntl(self.fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)

    def poll_event(self):
        """Return next real event as (type, number, value), or None if only
        synthetic init events (or no data) are pending."""
        while True:
            try:
                data = os.read(self.fd, self.STRUCT.size)
            except BlockingIOError:
                return None
            if len(data) < self.STRUCT.size:
                return None
            _t, value, type_, number = self.STRUCT.unpack(data)
            if type_ & JS_EVENT_INIT:
                continue
            return (type_ & 0x7F, number, value)

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass


class Window(Gtk.ApplicationWindow):
    LOG_MAX_LINES = 2000

    def __init__(self, app):
        super().__init__(application=app, title='MupenGTK')
        self.set_default_size(1100, 680)

        self.settings = mupengtksettings.read_settings()
        self.setter = mupengtksettings.set_settings()
        self.plugins = mupengtksettings.available_settings()
        self.process = None
        self._poll_source = None
        self._log_source = None
        self._binding_reader = None
        self._binding_source = None
        self._binding_target = None
        self._binding_button = None
        self.binding_rows = {}

        # Box-art / library state.
        self._library_folder = _get_library_folder()
        self._boxart_index = _load_boxart_index()
        self._boxart_token = 0
        self._boxart_current = None
        self._bulk_thread = None
        self._rom_rows = {}  # rom_path -> ListBoxRow
        self._search_query = ''

        # Persisted UI/emulator prefs.
        self._preserve_aspect = _pref_get_bool('preserve_aspect', True)
        self._dark_mode = _pref_get_bool('dark_mode', False)
        gtk_settings = Gtk.Settings.get_default()
        self._original_theme = (
            gtk_settings.get_property('gtk-theme-name')
            if gtk_settings is not None else None
        )
        self._apply_dark_mode(self._dark_mode)

        self._install_css()
        self._build_header()
        self._build_body()
        self._refresh_library()
        self._refresh_info_panel()
        self._refresh_binding_rows()
        self._update_running_state(running=False)

        self._install_accels(app)
        self.connect('destroy', self._on_destroy)

    # ---------- styling ----------
    def _install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    # ---------- header bar ----------
    def _build_header(self):
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        hb.set_title('MupenGTK')
        hb.set_subtitle('Nintendo 64')

        self.play_btn = Gtk.Button.new_from_icon_name(
            'media-playback-start-symbolic', Gtk.IconSize.BUTTON,
        )
        self.play_btn.set_tooltip_text('Start (Ctrl+P)')
        self.play_btn.get_style_context().add_class('suggested-action')
        self.play_btn.connect('clicked', self.on_start)
        hb.pack_start(self.play_btn)

        self.stop_btn = Gtk.Button.new_from_icon_name(
            'media-playback-stop-symbolic', Gtk.IconSize.BUTTON,
        )
        self.stop_btn.set_tooltip_text('Stop (Ctrl+.)')
        self.stop_btn.connect('clicked', self.on_stop)
        hb.pack_start(self.stop_btn)

        self.pause_btn = Gtk.Button.new_from_icon_name(
            'media-playback-pause-symbolic', Gtk.IconSize.BUTTON,
        )
        self.pause_btn.set_tooltip_text('Pause / Resume (Ctrl+Space)')
        self.pause_btn.connect('clicked', self._on_pause_clicked)
        hb.pack_start(self.pause_btn)

        self.status_dot = Gtk.Box()
        self.status_dot.set_valign(Gtk.Align.CENTER)
        self.status_dot.set_margin_start(8)
        hb.pack_start(self.status_dot)

        self.fullscreen_btn = Gtk.MenuButton(label='Fullscreen')
        self.fullscreen_btn.set_image(Gtk.Image.new_from_icon_name(
            'view-fullscreen-symbolic', Gtk.IconSize.BUTTON,
        ))
        self.fullscreen_btn.set_always_show_image(True)
        self.fullscreen_btn.set_tooltip_text('Fullscreen options')
        self.fullscreen_btn.set_popover(self._build_fullscreen_popover())
        hb.pack_end(self.fullscreen_btn)

        self.controls_btn = Gtk.MenuButton(label='Controls')
        self.controls_btn.set_image(Gtk.Image.new_from_icon_name(
            'input-gaming-symbolic', Gtk.IconSize.BUTTON,
        ))
        self.controls_btn.set_always_show_image(True)
        self.controls_btn.set_tooltip_text('Configure controller (applies to all ROMs)')
        self.controls_btn.set_popover(self._build_controls_popover())
        hb.pack_end(self.controls_btn)

        menu_btn = Gtk.MenuButton()
        menu_btn.set_image(Gtk.Image.new_from_icon_name(
            'open-menu-symbolic', Gtk.IconSize.BUTTON,
        ))
        menu_btn.set_tooltip_text('More')
        menu_btn.set_popup(self._build_menu())
        hb.pack_end(menu_btn)

        self.set_titlebar(hb)

    def _build_fullscreen_popover(self):
        popover = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(12)
        box.set_margin_end(12)

        self._fs_check = Gtk.CheckButton.new_with_label('Launch in fullscreen')
        self._fs_check.set_active(self.settings.get_fullscreen())
        self._fs_check.connect('toggled', self._on_toggle_fullscreen)
        box.pack_start(self._fs_check, False, False, 0)

        self._aspect_check = Gtk.CheckButton.new_with_label(
            'Keep native 4:3 aspect ratio'
        )
        self._aspect_check.set_tooltip_text(
            'Letterbox to the N64 4:3 aspect. Turn off to stretch to the '
            'whole screen.'
        )
        self._aspect_check.set_active(self._preserve_aspect)
        self._aspect_check.connect('toggled', self._on_toggle_aspect)
        box.pack_start(self._aspect_check, False, False, 0)

        popover.add(box)
        box.show_all()
        return popover

    def _build_menu(self):
        menu = Gtk.Menu()
        menu.append(self._build_plugins_item())
        menu.append(self._build_resolution_item())
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(self._build_save_slot_item())
        save_state = Gtk.MenuItem.new_with_label('Save State (F5)')
        save_state.connect('activate', self._send_key, 'F5')
        menu.append(save_state)
        load_state = Gtk.MenuItem.new_with_label('Load State (F7)')
        load_state.connect('activate', self._send_key, 'F7')
        menu.append(load_state)
        menu.append(Gtk.SeparatorMenuItem())
        refresh = Gtk.MenuItem.new_with_label('Rescan Plugins')
        refresh.connect('activate', self._on_rescan_plugins)
        menu.append(refresh)
        clear_log = Gtk.MenuItem.new_with_label('Clear Log')
        clear_log.connect('activate', self._on_clear_log)
        menu.append(clear_log)
        menu.append(Gtk.SeparatorMenuItem())
        dark = Gtk.CheckMenuItem.new_with_label('Dark mode')
        dark.set_active(self._dark_mode)
        dark.connect('toggled', self._on_toggle_dark_mode)
        menu.append(dark)
        menu.show_all()
        return menu

    def _build_plugins_item(self):
        item = Gtk.MenuItem.new_with_label('Plugins')
        sub = Gtk.Menu()
        specs = (
            ('Graphics', self.plugins.get_video_plugins(),
             self.settings.get_plugin_gfx(), 'gfx'),
            ('Audio', self.plugins.get_audio_plugins(),
             self.settings.get_plugin_audio(), 'audio'),
            ('Input', self.plugins.get_input_plugins(),
             self.settings.get_plugin_input(), 'input'),
            ('RSP', self.plugins.get_rsp_plugins(),
             self.settings.get_plugin_rsp(), 'rsp'),
        )
        for label, options, current, key in specs:
            entry = Gtk.MenuItem.new_with_label(label)
            entry.set_submenu(self._radio_menu(options, current, key))
            sub.append(entry)
        item.set_submenu(sub)
        return item

    def _build_resolution_item(self):
        item = Gtk.MenuItem.new_with_label('Resolution')
        item.set_submenu(
            self._radio_menu(RESOLUTIONS, self.settings.get_resolution(), 'resolution')
        )
        return item

    def _build_save_slot_item(self):
        item = Gtk.MenuItem.new_with_label('Save Slots (0–9)')
        sub = Gtk.Menu()
        group = None
        for i in range(10):
            slot = Gtk.RadioMenuItem(group=group, label=f'Slot {i}')
            group = group or slot
            slot.connect('activate', self._on_slot_activate, str(i))
            sub.append(slot)
        item.set_submenu(sub)
        return item

    def _radio_menu(self, options, current, kind):
        menu = Gtk.Menu()
        if not options:
            empty = Gtk.MenuItem.new_with_label('(none installed)')
            empty.set_sensitive(False)
            menu.append(empty)
            return menu
        group = None
        for opt in options:
            item = Gtk.RadioMenuItem(group=group, label=opt)
            group = group or item
            if opt == current:
                item.set_active(True)
            item.connect('toggled', self._on_option_toggled, kind)
            menu.append(item)
        return menu

    # ---------- body ----------
    def _build_body(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(560)
        paned.set_wide_handle(True)
        paned.pack1(self._build_rom_browser(), resize=True, shrink=False)
        paned.pack2(self._build_right_pane(), resize=True, shrink=False)
        root.pack_start(paned, True, True, 0)

        self.statusbar = Gtk.Statusbar()
        self.status_ctx = self.statusbar.get_context_id('Status')
        root.pack_start(self.statusbar, False, False, 0)

        self.add(root)

    def _build_rom_browser(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(10)
        box.set_margin_end(6)

        header = Gtk.Label(label='ROM LIBRARY', xalign=0)
        header.get_style_context().add_class('section-label')
        header.get_style_context().add_class('dim-label')
        box.pack_start(header, False, False, 0)

        folder_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.folder_label = Gtk.Label(xalign=0)
        self.folder_label.get_style_context().add_class('dim-label')
        self.folder_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        self.folder_label.set_hexpand(True)
        folder_row.pack_start(self.folder_label, True, True, 0)

        browse_btn = Gtk.Button.new_with_label('Choose folder…')
        browse_btn.set_image(Gtk.Image.new_from_icon_name(
            'folder-open-symbolic', Gtk.IconSize.BUTTON,
        ))
        browse_btn.set_always_show_image(True)
        browse_btn.set_tooltip_text('Select the folder containing your N64 ROMs')
        browse_btn.connect('clicked', self._on_browse_folder)
        folder_row.pack_end(browse_btn, False, False, 0)
        box.pack_start(folder_row, False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.download_art_btn = Gtk.Button.new_with_label('Download box art')
        self.download_art_btn.set_image(Gtk.Image.new_from_icon_name(
            'image-x-generic-symbolic', Gtk.IconSize.BUTTON,
        ))
        self.download_art_btn.set_always_show_image(True)
        self.download_art_btn.set_tooltip_text(
            'Fetch box art from arcadeartwork.org for every ROM in this folder'
        )
        self.download_art_btn.connect('clicked', self._on_download_all_art)
        actions.pack_start(self.download_art_btn, False, False, 0)
        self.art_progress = Gtk.Label(xalign=0)
        self.art_progress.get_style_context().add_class('dim-label')
        self.art_progress.set_ellipsize(Pango.EllipsizeMode.END)
        actions.pack_start(self.art_progress, True, True, 0)
        box.pack_start(actions, False, False, 0)

        self.rom_search = Gtk.SearchEntry()
        self.rom_search.set_placeholder_text('Search ROMs…')
        self.rom_search.connect('search-changed', self._on_search_changed)
        box.pack_start(self.rom_search, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_hexpand(True)
        scroll.set_vexpand(True)
        self.rom_list = Gtk.ListBox()
        self.rom_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.rom_list.get_style_context().add_class('rom-list')
        self.rom_list.set_filter_func(self._rom_row_filter, None)
        self.rom_list.connect('row-selected', self._on_rom_row_selected)
        self.rom_list.connect('row-activated', self._on_rom_row_activated)
        scroll.add(self.rom_list)
        box.pack_start(scroll, True, True, 0)

        return box

    def _on_search_changed(self, entry):
        self._search_query = _normalize(entry.get_text())
        self.rom_list.invalidate_filter()

    def _rom_row_filter(self, row, _data):
        if not self._search_query:
            return True
        path = getattr(row, 'rom_path', None)
        if not path:
            return False
        return self._search_query in _normalize(_rom_display_name(path))

    def _build_right_pane(self):
        notebook = Gtk.Notebook()
        notebook.set_margin_top(8)
        notebook.set_margin_bottom(8)
        notebook.set_margin_end(10)
        notebook.set_margin_start(4)
        notebook.append_page(self._build_info_tab(), Gtk.Label(label='Info'))
        notebook.append_page(self._build_log_tab(), Gtk.Label(label='Log'))
        return notebook

