            'Bindings are global (mupen64plus.cfg) and apply to every ROM. '
            'Restart the emulator to pick up new bindings.'
        )
        outer.pack_start(footer, False, False, 0)

        popover.add(outer)
        outer.show_all()
        return popover

    # ---------- state / refresh ----------
    def _refresh_info_panel(self):
        rom = self.settings.get_rom()
        if rom:
            self.rom_title.set_text(_rom_display_name(rom))
            self.rom_title.get_style_context().remove_class('rom-none')
            self.rom_path.set_text(rom)
            self.big_play.set_sensitive(True)
        else:
            self.rom_title.set_text('No ROM selected')
            self.rom_title.get_style_context().add_class('rom-none')
            self.rom_path.set_text('Choose a ROM from the library to get started')
            self.big_play.set_sensitive(False)
        self._update_boxart(rom)

        def basename_or_none(p):
            return os.path.basename(p) if p else '—'

        self.info_labels['resolution'].set_text(self.settings.get_resolution() or '—')
        self.info_labels['gfx'].set_text(basename_or_none(self.settings.get_plugin_gfx()))
        self.info_labels['audio'].set_text(basename_or_none(self.settings.get_plugin_audio()))
        self.info_labels['input'].set_text(basename_or_none(self.settings.get_plugin_input()))
        self.info_labels['rsp'].set_text(basename_or_none(self.settings.get_plugin_rsp()))
        self.info_labels['mode'].set_text(
            'Fullscreen' if self.settings.get_fullscreen() else 'Windowed'
        )

    def _reload_settings(self):
        self.settings = mupengtksettings.read_settings()
        self._refresh_info_panel()

    def _refresh_binding_rows(self):
        bindings = _load_bindings()
        for key, (label, _btn) in self.binding_rows.items():
            label.set_text(bindings.get(key) or '(unbound)')
        js = _first_joystick()
        if js:
            name = _joystick_name(js) or 'unknown model'
            self.controls_status.set_text(
                f'Detected: {name} ({js}). '
                'Auto-configure applies generic gamepad defaults; use Bind to override.'
            )
        else:
            self.controls_status.set_text(
                'No gamepad detected under /dev/input/js*. Plug one in and reopen this popover.'
            )

    def _update_running_state(self, running):
        ctx = self.status_dot.get_style_context()
        ctx.remove_class('status-dot-idle')
        ctx.remove_class('status-dot-running')
        ctx.add_class('status-dot-running' if running else 'status-dot-idle')
        self.stop_btn.set_sensitive(running)
        self.pause_btn.set_sensitive(running)
        self.play_btn.set_sensitive(not running and bool(self.settings.get_rom()))
        if hasattr(self, 'big_play'):
            self.big_play.set_sensitive(not running and bool(self.settings.get_rom()))

    def _start_poll(self):
        if self._poll_source is not None:
            return
        self._poll_source = GLib.timeout_add_seconds(1, self._poll_process)

    def _poll_process(self):
        if self.process is None:
            self._poll_source = None
            return False
        if self.process.poll() is not None:
            code = self.process.returncode
            self._teardown_process(code)
            return False
        return True

    def _teardown_process(self, code):
        if self._log_source is not None:
            GLib.source_remove(self._log_source)
            self._log_source = None
        if self.process and self.process.stdout:
            try:
                self.process.stdout.close()
            except Exception:
                pass
        self.process = None
        self._update_running_state(running=False)
        self.statusbar.push(self.status_ctx, f'Emulation ended (exit {code})')
        self._append_log(f'\n[mupengtk] process exited with code {code}\n')
        self._poll_source = None

    # ---------- accelerators ----------
    def _install_accels(self, app):
        accels = (
            ('play',       ['<Primary>p']),
            ('stop',       ['<Primary>period']),
            ('pause',      ['<Primary>space']),
            ('fullscreen', ['F11']),
        )
        for name, keys in accels:
            action = Gio.SimpleAction.new(name, None)
            action.connect('activate', self._on_accel, name)
            self.add_action(action)
            app.set_accels_for_action(f'win.{name}', keys)

    def _on_accel(self, _action, _param, name):
        if name == 'play':
            self.on_start(None)
        elif name == 'stop':
            self.on_stop(None)
        elif name == 'pause':
            self._on_pause_clicked(None)
        elif name == 'fullscreen':
            self._fs_check.set_active(not self._fs_check.get_active())

    # ---------- handlers ----------
    def _on_rom_row_selected(self, _listbox, row):
        if row is None:
            return
        path = getattr(row, 'rom_path', None)
        if not path or not os.path.isfile(path):
            return
        if path == self.settings.get_rom():
            return
        self.setter.set_rom(path)
        self._reload_settings()
        self.statusbar.push(self.status_ctx, f'Selected: {os.path.basename(path)}')

    def _on_rom_row_activated(self, _listbox, _row):
        self.on_start(None)

    def _on_browse_folder(self, _btn):
        dialog = Gtk.FileChooserDialog(
            title='Select ROM folder',
            parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dialog.add_buttons(
            'Cancel', Gtk.ResponseType.CANCEL,
            'Select', Gtk.ResponseType.ACCEPT,
        )
        dialog.set_local_only(True)
        if self._library_folder and os.path.isdir(self._library_folder):
            dialog.set_current_folder(self._library_folder)
        elif self.settings.get_rom():
            parent = os.path.dirname(self.settings.get_rom())
            if parent and os.path.isdir(parent):
                dialog.set_current_folder(parent)
        response = dialog.run()
        folder = dialog.get_filename() if response == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        if not folder:
            return
        try:
            _set_library_folder(folder)
        except OSError as e:
            self.statusbar.push(self.status_ctx, f'Failed to save folder: {e}')
            return
        self._library_folder = folder
        self._refresh_library()

    def _on_download_all_art(self, _btn):
        folder = self._library_folder
        if not folder:
            self.statusbar.push(self.status_ctx, 'Select a ROM folder first')
            return
        if self._bulk_thread and self._bulk_thread.is_alive():
            self.statusbar.push(self.status_ctx, 'Box-art download already running')
            return
        roms = _list_roms(folder)
        if not roms:
            self.statusbar.push(self.status_ctx, 'No ROMs in this folder')
            return
        self.download_art_btn.set_sensitive(False)
        self.art_progress.set_text('Preparing…')
        self._bulk_thread = threading.Thread(
            target=self._bulk_art_worker,
            args=(roms,),
            daemon=True,
        )
        self._bulk_thread.start()

    # ---------- library ----------
    def _refresh_library(self):
        for child in self.rom_list.get_children():
            self.rom_list.remove(child)
        self._rom_rows = {}
        folder = self._library_folder
        if not folder or not os.path.isdir(folder):
            self.folder_label.set_text('No folder selected')
            self.download_art_btn.set_sensitive(False)
            return
        self.folder_label.set_text(folder)
        self.folder_label.set_tooltip_text(folder)
        roms = _list_roms(folder)
        self.download_art_btn.set_sensitive(bool(roms))
        current = self.settings.get_rom()
        current_row = None
        for path in roms:
            row = self._make_rom_row(path)
            self.rom_list.add(row)
            self._rom_rows[path] = row
            if path == current:
                current_row = row
        self.rom_list.show_all()
        if current_row is not None:
            self.rom_list.select_row(current_row)
        if not roms:
            empty = Gtk.ListBoxRow()
            empty.set_selectable(False)
            empty.set_activatable(False)
            lbl = Gtk.Label(
                label='No .n64/.z64/.v64 files in this folder.',
                xalign=0,
            )
            lbl.get_style_context().add_class('dim-label')
            lbl.set_margin_top(12)
            lbl.set_margin_bottom(12)
            lbl.set_margin_start(8)
            empty.add(lbl)
            self.rom_list.add(empty)
            self.rom_list.show_all()

    def _make_rom_row(self, path):
        row = Gtk.ListBoxRow()
        row.rom_path = path
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hbox.set_margin_top(6)
        hbox.set_margin_bottom(6)
        hbox.set_margin_start(8)
        hbox.set_margin_end(8)
        thumb = Gtk.Image()
        thumb.set_size_request(*BOXART_THUMB)
        row.thumb = thumb
        self._apply_thumb(row, path)
        hbox.pack_start(thumb, False, False, 0)
        label = Gtk.Label(label=_rom_display_name(path), xalign=0)
        label.set_line_wrap(True)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        hbox.pack_start(label, True, True, 0)
        row.add(hbox)
        return row

    def _apply_thumb(self, row, path):
        pb = self._cached_pixbuf_for(path, BOXART_THUMB)
        if pb is not None:
            row.thumb.set_from_pixbuf(pb)
        else:
            row.thumb.set_from_icon_name('applications-games-symbolic', Gtk.IconSize.DND)

    def _cached_pixbuf_for(self, rom_path, size):
        slug = _match_slug(_rom_display_name(rom_path), self._boxart_index)
        if not slug:
            return None
        local = _boxart_local_path(slug)
        if not os.path.exists(local):
            return None
        return _load_pixbuf(local, size[0], size[1])

    # ---------- box art (info panel) ----------
    def _update_boxart(self, rom_path):
        self._boxart_token += 1
        token = self._boxart_token
        self._boxart_current = rom_path
        if not rom_path:
            self._set_boxart_placeholder()
            return
        pb = self._cached_pixbuf_for(rom_path, BOXART_LARGE)
        if pb is not None:
            self.boxart_image.set_from_pixbuf(pb)
            return
        self._set_boxart_placeholder()
        threading.Thread(
            target=self._boxart_worker,
            args=(rom_path, token),
            daemon=True,
        ).start()

    def _set_boxart_placeholder(self):
        self.boxart_image.set_from_icon_name(
            'applications-games-symbolic', Gtk.IconSize.DIALOG,
        )
        self.boxart_image.set_pixel_size(96)

    def _boxart_worker(self, rom_path, token):
        # If we don't have an index yet, try to build one.
        if not self._boxart_index:
            slugs = _fetch_boxart_index()
            if slugs:
                self._boxart_index = slugs
                _save_boxart_index(slugs)
        slug = _match_slug(_rom_display_name(rom_path), self._boxart_index)
        local = _download_boxart(slug) if slug else None
        GLib.idle_add(self._on_boxart_ready, rom_path, token, local)

    def _on_boxart_ready(self, rom_path, token, local):
        if token != self._boxart_token:
            return False
        if local and os.path.exists(local):
            pb = _load_pixbuf(local, BOXART_LARGE[0], BOXART_LARGE[1])
            if pb is not None:
                self.boxart_image.set_from_pixbuf(pb)
        # Refresh the matching list-row thumbnail too.
        row = self._rom_rows.get(rom_path)
        if row is not None:
            self._apply_thumb(row, rom_path)
        return False

    # ---------- bulk box-art download ----------
    def _bulk_art_worker(self, roms):
        if not self._boxart_index:
            GLib.idle_add(self._bulk_progress, 'Fetching index from arcadeartwork.org…')
            slugs = _fetch_boxart_index()
            if slugs:
                self._boxart_index = slugs
                _save_boxart_index(slugs)
        if not self._boxart_index:
            GLib.idle_add(self._bulk_done, 0, 0, 'Failed to fetch box-art index')
            return
        total = len(roms)
        hits = 0
        for i, path in enumerate(roms, 1):
            name = _rom_display_name(path)
            GLib.idle_add(self._bulk_progress, f'[{i}/{total}] {name}')
            slug = _match_slug(name, self._boxart_index)
            if not slug:
                continue
            local = _download_boxart(slug)
            if local:
                hits += 1
                GLib.idle_add(self._bulk_row_thumb, path)
        GLib.idle_add(self._bulk_done, hits, total, None)

    def _bulk_progress(self, text):
        self.art_progress.set_text(text)
        return False

    def _bulk_row_thumb(self, rom_path):
        row = self._rom_rows.get(rom_path)
        if row is not None:
            self._apply_thumb(row, rom_path)
        if rom_path == self._boxart_current:
            pb = self._cached_pixbuf_for(rom_path, BOXART_LARGE)
            if pb is not None:
                self.boxart_image.set_from_pixbuf(pb)
        return False

    def _bulk_done(self, hits, total, error):
        self.download_art_btn.set_sensitive(True)
        if error:
            self.art_progress.set_text(error)
            self.statusbar.push(self.status_ctx, error)
        else:
            msg = f'Box art: {hits}/{total} matched'
            self.art_progress.set_text(msg)
            self.statusbar.push(self.status_ctx, msg)
        return False

    def _on_option_toggled(self, widget, kind):
        if not widget.get_active():
            return
        value = widget.get_label()
        {
            'gfx': self.setter.set_gfx,
            'audio': self.setter.set_audio,
            'input': self.setter.set_input,
            'rsp': self.setter.set_rsp,
            'resolution': self.setter.set_resolution,
        }[kind](value)
        self._reload_settings()
        self.statusbar.push(self.status_ctx, f'{kind}: {os.path.basename(value)}')

    def _on_toggle_fullscreen(self, widget):
        self.setter.set_fullscreen(widget.get_active())
        self._reload_settings()

    def _on_toggle_aspect(self, widget):
        self._preserve_aspect = widget.get_active()
        _pref_set('preserve_aspect', 'true' if self._preserve_aspect else 'false')
        state = 'preserved (4:3)' if self._preserve_aspect else 'stretched to screen'
        self.statusbar.push(self.status_ctx, f'Aspect ratio: {state}')

    def _on_toggle_dark_mode(self, widget):
        self._dark_mode = widget.get_active()
        _pref_set('dark_mode', 'true' if self._dark_mode else 'false')
        self._apply_dark_mode(self._dark_mode)

    def _apply_dark_mode(self, dark):
        s = Gtk.Settings.get_default()
        if s is None:
            return
        if dark:
            # Explicit theme swap is more reliable than the prefer-dark hint,
            # which many themes ignore. Adwaita-dark is shipped with GTK.
            s.set_property('gtk-theme-name', 'Adwaita-dark')
            s.set_property('gtk-application-prefer-dark-theme', True)
        else:
            s.set_property('gtk-application-prefer-dark-theme', False)
            if self._original_theme:
                s.set_property('gtk-theme-name', self._original_theme)

    def _on_slot_activate(self, widget, key):
        if widget.get_active():
            self._send_key(widget, key)

    def _on_pause_clicked(self, _widget):
        self._send_key(None, 'p')

    def _on_rescan_plugins(self, _widget):
        self.plugins = mupengtksettings.available_settings()
        counts = sum(len(getattr(self.plugins, f'get_{k}_plugins')())
                     for k in ('video', 'audio', 'input', 'rsp'))
        self.statusbar.push(self.status_ctx, f'Rescanned plugins ({counts} found)')

    # ---------- binding ----------
    def _on_bind_clicked(self, button, key):
        js = _first_joystick()
        if not js:
            self.statusbar.push(self.status_ctx, 'No gamepad detected')
            return
        self._cancel_binding()
        try:
            self._binding_reader = JoystickReader(js)
        except OSError as e:
            self.statusbar.push(self.status_ctx, f'Could not open {js}: {e}')
            return
        self._binding_target = key
        self._binding_button = button
        button.set_label('Press…')
        button.get_style_context().add_class('binding-capturing')
        self._binding_source = GLib.timeout_add(30, self._poll_binding)
        hint = 'move the stick' if key in _AXIS_PAIR_BUTTONS else 'press a button or move a stick'
        self.statusbar.push(self.status_ctx, f'{key}: {hint}…')

    def _cancel_binding(self):
        if self._binding_source is not None:
            GLib.source_remove(self._binding_source)
            self._binding_source = None
        if self._binding_reader is not None:
            self._binding_reader.close()
            self._binding_reader = None
        if self._binding_button is not None:
            self._binding_button.set_label('Bind')
            self._binding_button.get_style_context().remove_class('binding-capturing')
            self._binding_button = None
        self._binding_target = None

    def _poll_binding(self):
        if self._binding_reader is None:
            return False
        ev = self._binding_reader.poll_event()
        if ev is None:
            return True
        type_, number, value = ev
        target = self._binding_target
        binding = None
        if target in _AXIS_PAIR_BUTTONS:
            if type_ == JS_EVENT_AXIS and abs(value) > 20000:
                binding = f'axis({number}-,{number}+)'
        else:
            if type_ == JS_EVENT_BUTTON and value == 1:
                binding = f'button({number})'
            elif type_ == JS_EVENT_AXIS and abs(value) > 20000:
                sign = '+' if value > 0 else '-'
                binding = f'axis({number}{sign})'
        if binding is None:
            return True
        try:
            _save_binding(target, binding)
        except OSError as e:
            self.statusbar.push(self.status_ctx, f'Failed to save binding: {e}')
        else:
            self.statusbar.push(self.status_ctx, f'{target} ← {binding}')
        self._cancel_binding()
        self._refresh_binding_rows()
        return False

    def _on_auto_configure(self, _btn):
        js = _first_joystick()
        if not js:
            self.statusbar.push(self.status_ctx, 'No gamepad detected')
            return
        try:
            name, count = _apply_auto_config(js)
        except OSError as e:
            self.statusbar.push(self.status_ctx, f'Failed to write config: {e}')
            return
        label = name or js
        self.statusbar.push(
            self.status_ctx,
            f'Auto-configured {count} bindings for {label}. Restart the emulator to apply.',
        )
        self._refresh_binding_rows()

    def _on_clear_binding(self, _btn, key):
        try:
            _save_binding(key, '')
        except OSError as e:
            self.statusbar.push(self.status_ctx, f'Failed to clear binding: {e}')
        else:
            self.statusbar.push(self.status_ctx, f'{key} cleared')
        self._refresh_binding_rows()

    # ---------- emulator process ----------
    def on_start(self, _widget):
        self._reload_settings()
        settings = self.settings
        rom = settings.get_rom()
        if not rom:
            self.statusbar.push(self.status_ctx, 'No ROM selected')
            return
        if not shutil.which('mupen64plus'):
            self.statusbar.push(self.status_ctx, 'mupen64plus is not installed')
            return
        cmd = ['mupen64plus']
        if self._preserve_aspect:
            # Force each common gfx plugin to letterbox to 4:3. Unused
            # sections are silently ignored by mupen64plus.
            cmd += [
                '--set', 'Video-GLideN64[AspectRatio]=1',
                '--set', 'Video-Glide64mk2[aspect]=0',
                '--set', 'Video-Rice[AspectRatio]=1',
            ]
        for flag, value in (
            ('--gfx', settings.get_plugin_gfx()),
            ('--audio', settings.get_plugin_audio()),
            ('--input', settings.get_plugin_input()),
            ('--rsp', settings.get_plugin_rsp()),
            ('--resolution', settings.get_resolution()),
        ):
            if value:
                cmd += [flag, value]
        cmd.append('--fullscreen' if settings.get_fullscreen() else '--windowed')
        cmd.append(rom)

        self._terminate_process()
        self._append_log(f'\n[mupengtk] launching: {" ".join(cmd)}\n')
        try:
            self.process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                bufsize=0,
            )
        except OSError as e:
            self.statusbar.push(self.status_ctx, f'Failed to launch: {e}')
            self._append_log(f'[mupengtk] launch failed: {e}\n')
            return

        self._attach_log_watch(self.process.stdout.fileno())
        self._update_running_state(running=True)
        self._start_poll()
        self._launch_pid = self.process.pid
        self.statusbar.push(
            self.status_ctx,
            f'Started {os.path.basename(rom)} (pid {self.process.pid})',
        )
        # Detect very-quick exit and surface it prominently
        GLib.timeout_add_seconds(2, self._check_quick_exit, self.process.pid)

    def _check_quick_exit(self, pid):
        if self.process is None or self.process.pid != pid:
            return False
        code = self.process.poll()
        if code is not None and code != 0:
            self.statusbar.push(
                self.status_ctx,
                f'mupen64plus exited quickly (code {code}) — check the Log tab',
            )
        return False

    def on_stop(self, _widget):
        if self._terminate_process():
            self._update_running_state(running=False)
            self.statusbar.push(self.status_ctx, 'Emulation stopped')

    def _terminate_process(self):
        if self.process is None or self.process.poll() is not None:
            if self._log_source is not None:
                GLib.source_remove(self._log_source)
                self._log_source = None
            self.process = None
            return False
        self.process.terminate()
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.kill()
        if self._log_source is not None:
            GLib.source_remove(self._log_source)
            self._log_source = None
        self.process = None
        return True

    # ---------- log capture ----------
    def _attach_log_watch(self, fd):
        flags = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
        self._log_source = GLib.io_add_watch(
            fd,
            GLib.PRIORITY_DEFAULT,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            self._on_log_read,
        )

    def _on_log_read(self, fd, condition):
        try:
            data = os.read(fd, 4096)
        except BlockingIOError:
            return True
        except OSError:
            return False
        if not data:
            return False
        self._append_log(data.decode('utf-8', errors='replace'))
        return True

    def _append_log(self, text):
        if not hasattr(self, 'log_buffer'):
            return
        end = self.log_buffer.get_end_iter()
        self.log_buffer.insert(end, text)
        # Trim to LOG_MAX_LINES
        line_count = self.log_buffer.get_line_count()
        if line_count > self.LOG_MAX_LINES:
            start = self.log_buffer.get_start_iter()
            cut = self.log_buffer.get_iter_at_line(line_count - self.LOG_MAX_LINES)
            self.log_buffer.delete(start, cut)
        mark = self.log_buffer.get_insert()
        self.log_view.scroll_mark_onscreen(mark)

    def _on_clear_log(self, _widget):
        if hasattr(self, 'log_buffer'):
            self.log_buffer.set_text('')

    # ---------- keyboard signalling ----------
    def _send_key(self, _widget, key):
        if self.process is None or self.process.poll() is not None:
            self.statusbar.push(self.status_ctx, 'Emulator is not running')
            return
        if self._send_key_xdotool(key):
            return
        if self._send_key_wayland(key):
            self.statusbar.push(self.status_ctx, f'Sent {key} to focused window')
            return
        self.statusbar.push(
            self.status_ctx,
            'Cannot send key — install xdotool (X11) or wtype/ydotool (Wayland)',
        )

    def _send_key_xdotool(self, key):
        if not shutil.which('xdotool'):
            return False
        try:
            out = subprocess.check_output(
                ['xdotool', 'search', '--pid', str(self.process.pid)],
                text=True,
            )
        except subprocess.CalledProcessError:
            return False
        windows = out.strip().splitlines()
        if not windows:
            return False
        subprocess.run(
            ['xdotool', 'windowactivate', '--sync', windows[-1], 'key', key],
            check=False,
        )
        return True

    def _send_key_wayland(self, key):
        if shutil.which('wtype'):
            subprocess.run(['wtype', '-P', key, '-R', key], check=False)
            return True
        if shutil.which('ydotool'):
            keycode = _YDOTOOL_KEYCODES.get(key)
            if keycode is None:
                return False
            subprocess.run(
                ['ydotool', 'key', f'{keycode}:1', f'{keycode}:0'],
                check=False,
            )
            return True
        return False

    # ---------- lifecycle ----------
    def _on_destroy(self, _widget):
        self._cancel_binding()
        self._terminate_process()


class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = Window(self)
        icon = _find_icon()
        if icon:
            win.set_icon_from_file(icon)
        win.show_all()


def main():
    return Application().run(sys.argv)


if __name__ == '__main__':
    sys.exit(main())
