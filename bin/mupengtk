        for i, (key, label) in enumerate(N64_BUTTONS):
            name_lbl = Gtk.Label(label=label, xalign=0)
            grid.attach(name_lbl, 0, i, 1, 1)

            value_lbl = Gtk.Label(label='(unbound)', xalign=0)
